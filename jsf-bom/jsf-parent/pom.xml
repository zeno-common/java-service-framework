    <profile>
      <id>pd-docker</id>
      <properties>
        <docker.from>eclipse-temurin:25-jre-alpine</docker.from>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <imagePullPolicy>IfNotPresent</imagePullPolicy>
              <useColor>true</useColor>
              <verbose>true</verbose>
              <images>
                <image>
                  <alias>${project.artifactId}</alias>
                  <name>soil/${project.artifactId}</name>
                  <build>
                    <from>${docker.from}</from>
                    <tags>
                      <tag>${project.version}-${env}</tag>
                    </tags>
                    <workdir>/programs</workdir>
                    <assemblies>
                      <assembly>
                        <name>executable-jar</name>
                        <descriptorRef>artifact</descriptorRef>
                        <targetDir>/programs</targetDir>
                      </assembly>
                    </assemblies>
                    <buildOptions>
                      <forcerm>true</forcerm>
                    </buildOptions>
                    <entryPoint>
                      <exec>
                        <arg>java</arg>
                        <arg>-Dfile.encoding=UTF-8</arg>
                        <arg>-Djdk.virtualThreadScheduler.maxPoolSize=256</arg>
                        <arg>-Djava.security.egd=file:/dev/urandom</arg>
                        <arg>-Xss512k</arg>
                        <arg>-Xlog:gc*:file=/programs/logs/gc.log:time,uptime,level,tags:filecount=3,filesize=100M</arg>
                        <arg>-XX:+UseG1GC</arg>
                        <arg>-XX:+UseCompactObjectHeaders</arg>
                        <arg>-XX:MaxDirectMemorySize=512m</arg>
                        <arg>-XX:+AlwaysPreTouch</arg>
                        <arg>-XX:+HeapDumpOnOutOfMemoryError</arg>
                        <arg>-XX:HeapDumpPath=/programs/heapdump.hprof</arg>
                        <arg>-XX:ConcGCThreads=4</arg>
                        <arg>--enable-native-access=ALL-UNNAMED</arg>
<!--                        <arg>&#45;&#45;add-opens java.base/java.lang=ALL-UNNAMED</arg>-->
                        <arg>--sun-misc-unsafe-memory-access=allow</arg>
                        <arg>-jar</arg>
                        <arg>${project.build.finalName}.jar</arg>
                      </exec>
                    </entryPoint>
                    <env>
                      <TZ>Asia/Shanghai</TZ>
                      <LANG>C.UTF-8</LANG>
                      <LC_ALL>C.UTF-8</LC_ALL>
                    </env>
                  </build>
                  <run>
                    <!--                    <hostname>${project.artifactId}-${env}</hostname>-->
                    <network>
                      <mode>bridge</mode>
                    </network>
                    <restartPolicy>
                      <name>on-failure</name>
                    </restartPolicy>
                    <containerNamePattern>%n</containerNamePattern>
                    <!--                    <extraHosts>-->
                    <!--                      <host>ssy-dev:192.168.1.200</host>-->
                    <!--                    </extraHosts>-->
                  </run>
                </image>
              </images>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

